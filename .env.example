# Copy to .env and fill in.  Never commit .env.

# --- required -------------------------------------------------------------
# Tradier API token (market data).  TRADIER_API_KEY is accepted as an alias.
TRADIER_API_TOKEN=

# --- optional -------------------------------------------------------------
TRADIER_ACCOUNT_ID=
TRADIER_BASE_URL=https://api.tradier.com/v1

TICKERS=SPY,QQQ,IWM
DISCOVERY_STRIKES_EACH_SIDE=10
QUOTE_BATCH_SIZE=50
POLL_INTERVAL_SECONDS=60
# Run full-chain discovery every N cycles (1 = every cycle).
DISCOVERY_INTERVAL_CYCLES=1

DATA_DIR=./data
LOG_DIR=./logs
LOG_RETENTION_DAYS=7

MARKET_TIMEZONE=America/New_York
OPTION_SESSION_OPEN=09:30
OPTION_SESSION_CLOSE=16:15
# Minutes past the NYSE equity close to keep collecting on early-close days.
# See market_clock.py: published schedules are ambiguous for ETF options on
# half days, so this is explicit and configurable.  Set to 0 to stop at 13:00.
EARLY_CLOSE_OPTION_EXTRA_MINUTES=15

HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_MAX_ATTEMPTS=3

HEALTHY_COVERAGE_PCT=98
WARNING_COVERAGE_PCT=90
